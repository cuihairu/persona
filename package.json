{
  "name": "persona-monorepo",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "workspaces": [
    "desktop",
    "browser/chromium-extension",
    "website"
  ],
  "description": "Persona monorepo: core (Rust), CLI (Rust), desktop (Tauri+React), browser extension, website, server (Rust), agents, docs",
  "scripts": {
    "build": "echo \"Use 'cargo build' for Rust crates; use pnpm scripts for JS packages.\"",
    "dev:desktop": "pnpm --filter persona-desktop run dev",
    "build:desktop": "pnpm --filter persona-desktop run build",
    "test:desktop": "pnpm --filter persona-desktop run test",
    "dev:extension": "pnpm --filter persona-chromium-extension run build --watch",
    "build:extension": "pnpm --filter persona-chromium-extension run build",
    "dev:website": "pnpm --filter persona-website run dev",
    "build:website": "pnpm --filter persona-website run build",
    "dev:docs": "npm --prefix docs run dev",
    "build:docs": "npm --prefix docs run build",
    "preview:docs": "npm --prefix docs run preview"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<7.29": "7.29.6",
      "@babel/runtime@<7.26.10": "^7.26.10",
      "@remix-run/router@<1.23.3": "^1.23.3",
      "ajv@<7": "6.14.0",
      "axios@<1": "0.33.0",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "bn.js@4": "4.12.3",
      "bn.js@<5.2.3": "5.2.3",
      "body-parser@<1.20.6": "1.20.6",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "browserslist@<4.28.7": "^4.28.7",
      "colord@<2.9.4": "2.9.4",
      "decode-uri-component@<0.5.0": "0.5.0",
      "esbuild@<0.28.1": "^0.28.1",
      "fast-uri@<3.1.4": "^3.1.4",
      "flatted@<3.4.0": "^3.4.2",
      "follow-redirects@<1.16.0": "^1.16.0",
      "form-data@<4.0.6": "^4.0.6",
      "handlebars@<4.7.9": "4.7.9",
      "immer@<9.0.6": "9.0.6",
      "immutable@<4.3.8": "^4.3.8",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "lodash-es@<4.18.0": "4.18.0",
      "lodash@4.17.21": "4.18.0",
      "minimatch@3": "3.1.4",
      "minimatch@9": "9.0.7",
      "nanoid@<3.3.18": "3.3.18",
      "node-fetch@1": "2.6.7",
      "node-fetch@2": "2.6.7",
      "path-to-regexp@0.1": "0.1.13",
      "path-to-regexp@1": "1.9.0",
      "path-to-regexp@8": "^8.4.0",
      "piscina@<4.9.3": "4.9.3",
      "postcss-selector-parser@6": "6.1.3",
      "postcss-selector-parser@7": "7.1.3",
      "postcss@<8.5.18": "^8.5.18",
      "qs@<6.16.0": "^6.16.0",
      "react-router@<7.18.2": "^7.18.2",
      "send@<0.19.0": "0.19.0",
      "svgo@2": "2.8.4",
      "yaml@1": "1.10.3"
    }
  }
}
