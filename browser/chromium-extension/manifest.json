{
  "manifest_version": 3,
  "name": "Persona Autofill",
  "description": "Preview extension for switching Persona identities, autofilling credentials, and initiating SSH workflows.",
  "version": "0.1.0",
  "action": {
    "default_title": "Persona",
    "default_popup": "public/popup.html"
  },
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "commands": {
    "open_search": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Open Persona mini search"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/webauthnHook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "public/icons/icon128.png"
  }
}

