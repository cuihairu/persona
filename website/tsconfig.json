{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "react-jsxdev",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    /* TS 7 移除了 baseUrl；相对 './' 写法两代都合法（5.x 允许相对 paths，
       7.x 按 tsconfig 相对根解析） */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", ".umi"]
}
