{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "react-jsxdev",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    /* TS 7 removed baseUrl; the relative './' form is valid in both versions
       (5.x allows relative paths, 7.x resolves them against the tsconfig root) */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", ".umi"]
}
